<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / analyzers come from Directory.Build.props.
       Package versions come from Directory.Packages.props (central package management). -->

  <!-- Registry: the `registry` schema (intent + provisioning-run audit) and the Wolverine
       EnvironmentSaga state class. EF Core + Npgsql like Pdp.ControlPlane.Ipam; WolverineFx for
       the Saga base type (data-model §3). No project references (T010). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Pin Relational to match EF Core (10.0.9). The Npgsql provider (10.0.2) floors it to 10.0.4;
         without this pin the higher EF Core version conflicts downstream (MSB3277). Pinning here in
         the library flows the resolved version to every consumer (Verbs/Api/Cli + their tests). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="WolverineFx" />
    <!-- Catalog sync (spec 008): every parameterSchema in archetypes/catalog.json must parse as a
         valid draft 2020-12 schema before the projection is applied. -->
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

</Project>
