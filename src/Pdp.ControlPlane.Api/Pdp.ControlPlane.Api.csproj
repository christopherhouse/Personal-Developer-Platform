<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework / Nullable / ImplicitUsings / analyzers come from Directory.Build.props.
       Package versions come from Directory.Packages.props (central package management). -->

  <!-- Api: the internal ASP.NET Core host (built host-ready; spec 007 deploys it to ACA).
       Hosts the GitHub webhook handler (Octokit.Webhooks.AspNetCore), the Wolverine durable
       outbox/inbox + reconciler schedule, and Azure Monitor OTel. The webhook ingress is the one
       sanctioned public surface (Article IX), fronted by Pdp.ControlPlane.Ingress. -->
  <ItemGroup>
    <PackageReference Include="Octokit.Webhooks.AspNetCore" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pdp.ControlPlane.Verbs\Pdp.ControlPlane.Verbs.csproj" />
    <ProjectReference Include="..\Pdp.ControlPlane.Dispatch\Pdp.ControlPlane.Dispatch.csproj" />
    <ProjectReference Include="..\Pdp.ControlPlane.Registry\Pdp.ControlPlane.Registry.csproj" />
  </ItemGroup>

</Project>
