<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings / analyzers come from Directory.Build.props.
       Package versions come from Directory.Packages.props (central package management). -->

  <!-- The `pdp` CLI (System.CommandLine 2.0 GA). Assembly name `pdp`. Hosts the verb layer
       in-process under the owner's DefaultAzureCredential; a mutating command dispatches then polls
       the registry/GitHub correlation to terminal (or returns immediately with a no-wait flag). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pdp</AssemblyName>
    <RootNamespace>Pdp.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Azure.Identity" />
    <!-- `pdp migrate` applies the ipam + registry EF Core schemas to a dev/local DB (no host start). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pdp.ControlPlane.Verbs\Pdp.ControlPlane.Verbs.csproj" />
  </ItemGroup>

  <!-- Local config: appsettings.json is a committed template; appsettings.Development.json is
       gitignored and carries the per-machine Postgres/GitHub values so `dotnet run` (and the Aspire
       migrator) pick them up without per-session env vars. Both are copied next to the assembly so
       the host (content root = AppContext.BaseDirectory) finds them regardless of working directory. -->
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Development.json')" />
  </ItemGroup>

</Project>
