<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET Aspire AppHost SDK is an MSBuild SDK delivered via NuGet (no workload install);
       its version is pinned inline here because SDK references can't use central package management. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.5" />

  <!-- TargetFramework / Nullable / ImplicitUsings / analyzers come from Directory.Build.props.
       Package versions come from Directory.Packages.props (central package management). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <!-- Local dev orchestration (one F5): Postgres container + Api + Ingress. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pdp.ControlPlane.Api\Pdp.ControlPlane.Api.csproj" />
    <ProjectReference Include="..\Pdp.ControlPlane.Ingress\Pdp.ControlPlane.Ingress.csproj" />
  </ItemGroup>

</Project>
