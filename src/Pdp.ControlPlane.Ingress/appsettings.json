{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "//": "The ONE public surface (Article IX): POST /webhooks/github → internal Api; /mcp + the OAuth 2.1",
  "// ": "protected-resource-metadata doc → internal mcp (streamable-HTTP passthrough; YARP forwards the",
  "//  ": "Authorization header and does NO token validation — the mcp server is the enforcement point,",
  "//   ": "contracts/hosting-topology.md/identity-and-auth.md). Everything else is unmatched and 404s.",
  "//    ": "Destination Addresses are overridden by the Aspire AppHost for local dev and by spec-007 ACA",
  "//     ": "config in production (ReverseProxy__Clusters__<id>__Destinations__<name>__Address).",
  "ReverseProxy": {
    "Routes": {
      "github-webhook": {
        "ClusterId": "control-plane-api",
        "Match": {
          "Path": "/webhooks/github",
          "Methods": [ "POST" ]
        }
      },
      "mcp": {
        "ClusterId": "control-plane-mcp",
        "Match": {
          "Path": "/mcp"
        }
      },
      "mcp-sub": {
        "ClusterId": "control-plane-mcp",
        "Match": {
          "Path": "/mcp/{**catch-all}"
        }
      },
      "mcp-prm": {
        "ClusterId": "control-plane-mcp",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource"
        }
      },
      "mcp-prm-sub": {
        "ClusterId": "control-plane-mcp",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "control-plane-api": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:5080/"
          }
        }
      },
      "control-plane-mcp": {
        "Destinations": {
          "mcp": {
            "Address": "http://localhost:5180/"
          }
        }
      }
    }
  }
}
